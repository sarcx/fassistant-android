    <string name="app_name">Fassistant</string>
    <string name="admin_description">Prevents this watchdog from being uninstalled or force-stopped.</string>

    <!-- Main screen -->
    <string name="main_status_running">Watchdog running</string>
    <string name="main_status_stopped">Watchdog stopped</string>
    <string name="main_version">Version %1$s (%2$d)</string>
