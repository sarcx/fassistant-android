    <string name="main_never">never</string>
    <string name="main_revival">Restart alarm: %1$s · Scheduled job: %2$s</string>
    <string name="main_yes">yes</string>
    <string name="main_no">no</string>
    <string name="main_force_stopped">Something force-stopped Fassistant. Android clears a stopped app\'s alarms and withholds its broadcasts, so it cannot start itself again — not even after a reboot. Work through Manufacturer settings to stop this happening again.</string>
    <string name="main_gaps_heading">Times it was not running</string>
    <string name="main_gap_entry">%1$s, ending %2$s</string>
    <string name="main_watched_heading">Watched apps</string>
    <string name="main_watched_empty">No apps yet. Add the ones that should never stay dead.</string>
    <string name="main_add_apps">Add apps</string>
    <string name="main_start">Start watchdog</string>
    <string name="main_stop">Stop watchdog</string>
    <string name="main_behaviour_heading">Behaviour</string>
    <string name="main_return_to_previous">Go back to what I was doing</string>
    <string name="main_return_to_previous_why">Android will not let an app be reopened without bringing it to the front, so Fassistant brings back whatever was on screen a moment later. You may still see it flick past. Apps set to \"keep it in front\" are left alone.</string>
    <string name="main_permissions_heading">Permissions</string>
    <string name="main_oem_setup">Manufacturer settings</string>
    <string name="main_view_log">View log</string>
    <string name="main_check_now">Check now</string>
    <string name="main_enumeration_exact">This phone allows process checks, so deaths are detected exactly.</string>
    <string name="main_enumeration_inferred">This phone hides other apps\' processes, so deaths are inferred from notifications and media sessions.</string>

    <!-- Permission rows -->
    <string name="grant_overlay">Draw over other apps</string>
    <string name="grant_overlay_why">Without this, Android silently refuses to let us reopen anything.</string>
    <string name="grant_usage">Usage access</string>
    <string name="grant_usage_why">Tells us which app is in front.</string>
    <string name="grant_notifications">Notification access</string>
    <string name="grant_notifications_why">Our strongest signal that an app has died.</string>
    <string name="grant_battery">Unrestricted battery</string>
    <string name="grant_battery_why">Stops Android delaying our checks while the screen is off.</string>
    <string name="grant_install">Install unknown apps</string>
    <string name="grant_install_why">Lets Fassistant install its own updates.</string>
    <string name="grant_granted">Granted</string>
    <string name="grant_missing">Missing</string>
    <string name="grant_fix">Fix</string>

