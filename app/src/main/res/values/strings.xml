    <!-- Detectability badges -->
    <string name="badge_exact">Exact</string>
    <string name="badge_exact_why">This phone lets us check the process directly.</string>
    <string name="badge_strong">Strong</string>
    <string name="badge_strong_notification">Seen with an ongoing notification.</string>
    <string name="badge_strong_media">Seen playing media.</string>
    <string name="badge_weak">Weak</string>
    <string name="badge_weak_why">No signal seen yet, so this app can only be reopened on a timer. The badge improves by itself if a signal appears.</string>
    <string name="badge_no_launcher">No launcher</string>
    <string name="badge_no_launcher_why">This app has no screen to open, so it can never be reopened.</string>

    <!-- App detail -->
    <string name="detail_mode_heading">When to reopen it</string>
    <string name="detail_mode_on_signal">Only when it dies</string>
    <string name="detail_mode_on_signal_why">Reopen the moment a death signal arrives. Nothing happens otherwise.</string>
    <string name="detail_mode_keep_in_front">Keep it in front</string>
    <string name="detail_mode_keep_in_front_why">Reopen whenever it has not been the app on screen for a while. One app at a time.</string>
    <string name="detail_mode_sweep">Reopen on a timer</string>
    <string name="detail_mode_sweep_why">Reopen periodically whether or not we can tell it died. Interrupts whatever is on screen.</string>
    <string name="detail_grace">Wait before reopening: %1$s</string>
    <string name="detail_sweep_every">Reopen every: %1$s</string>
